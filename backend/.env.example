# Backend Environment Variables

# RPC URL for blockchain connection (C1: Security - Don't commit real API keys!)
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Orchestrator wallet private key (C7: Security - NEVER commit this!)
PRIVATE_KEY=your_private_key_here

# Health monitoring port
HEALTH_PORT=3000
